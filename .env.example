DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=

NODE_ENV=production

POSTGRES_PASSWORD=
DATABASE_URL=postgresql://tickets:CHANGE_ME@db:5432/tickets

SUDO_ROLE_IDS=
SUDO_USER_IDS=

BOT_OWNER_ID=

BOT_IMAGE=ghcr.io/jason-tucker/euphoric-tickets:latest

UPTIME_KUMA_PUSH_URL=

# Public URL of the web companion (used for "view in web" links).
WEB_BASE_URL=https://tickets.euphoric.fm

# Private-network URL of the web companion for bot -> web server-to-server
# calls (the notify bridge), e.g. http://tickets-web:3000. Leave blank to fall
# back to WEB_BASE_URL. Public links always use WEB_BASE_URL.
WEB_INTERNAL_URL=

# REQUIRED (v0.8.2+). Shared secret authenticating every web <-> bot internal
# call (x-internal-token: web -> bot DM / TicketTool / Sudo / Integration API,
# bot -> web notify). At least 32 characters, and the identical value in the
# web app. The bot refuses to start without it; there is no DISCORD_BOT_TOKEN
# fallback. Generate one with:  openssl rand -hex 32
INTERNAL_TOKEN=

# Port the bot's internal HTTP server binds (keep on the private docker
# network — never publish it to the host). Default 8787.
INTERNAL_PORT=8787

# Optional (v0.9.0+). copium.pics paste upload token. When set, closing a
# ticket also posts a plain-text transcript paste, links it in the opener's
# close DM and stores it in tickets.external_transcript_url (web dashboard).
# Leave blank to disable (no request is made). Secret — never logged.
COPIUM_TOKEN=
# copium.pics API origin. Default https://copium.pics.
COPIUM_API_BASE=https://copium.pics
# Optional custom domain for paste links: the host of the returned page URL
# is replaced with this, e.g. i.tucker.host -> https://i.tucker.host/i/<id>.
COPIUM_LINK_HOST=
# Optional copium album id. Successful transcript pastes are also added to
# this album. Leave blank to skip.
COPIUM_ALBUM_ID=
